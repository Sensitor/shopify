{% comment %} Rich Text Section {% endcomment %}
<section class="rich-text-section section-padding">
  <div class="container">
    <div class="rich-text-content">
      {% if section.settings.heading != blank %}
        <h2>{{ section.settings.heading }}</h2>
      {% endif %}
      <div>{{ section.settings.text }}</div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Texte enrichi",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titre"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Contenu",
      "default": "<p>Utilisez ce bloc pour ajouter du contenu textuel a votre page.</p>"
    }
  ],
  "presets": [
    {
      "name": "Texte enrichi"
    }
  ]
}
{% endschema %}
