{% comment %} Featured Products Section {% endcomment %}
<section class="featured-products section-padding">
  <div class="container">
    <div class="section-header">
      <span class="section-tag">{{ section.settings.tag }}</span>
      <h2 class="section-title">{{ section.settings.title }}</h2>
      <p class="section-subtitle">{{ section.settings.subtitle }}</p>
    </div>

    <div class="products-grid">
      {% assign collection = collections[section.settings.collection] %}
      {% if collection != blank and collection.products.size > 0 %}
        {% for product in collection.products limit: section.settings.products_count %}
          {% render 'product-card', product: product %}
        {% endfor %}
      {% else %}
        {% for i in (1..8) %}
          {% render 'product-card-placeholder', index: i %}
        {% endfor %}
      {% endif %}
    </div>

    {% if section.settings.show_view_all %}
      <div class="section-footer">
        <a href="{{ collection.url | default: '/collections/all' }}" class="btn btn-outline">
          Voir tous les produits
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Produits vedettes",
  "settings": [
    {
      "type": "text",
      "id": "tag",
      "label": "Tag",
      "default": "Best-sellers"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "Nos Produits Phares"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Sous-titre",
      "default": "Les solutions les plus plébiscitées par nos clients"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_count",
      "label": "Nombre de produits",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Afficher le bouton Voir tout",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Produits vedettes"
    }
  ]
}
{% endschema %}
