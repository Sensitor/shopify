{% comment %} Hero Banner Section {% endcomment %}
<section class="hero-banner" style="{% if section.settings.bg_image %}background-image: url('{{ section.settings.bg_image | image_url: width: 1920 }}');{% endif %}">
  <div class="hero-overlay"></div>
  <div class="container hero-content">
    <div class="hero-text">
      <span class="hero-badge">{{ section.settings.badge_text }}</span>
      <h1 class="hero-title">{{ section.settings.title }}</h1>
      <p class="hero-subtitle">{{ section.settings.subtitle }}</p>
      <div class="hero-actions">
        {% if section.settings.button_text != blank %}
          <a href="{{ section.settings.button_url }}" class="btn btn-primary btn-lg">
            {{ section.settings.button_text }}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        {% endif %}
        {% if section.settings.button_text_2 != blank %}
          <a href="{{ section.settings.button_url_2 }}" class="btn btn-outline btn-lg">
            {{ section.settings.button_text_2 }}
          </a>
        {% endif %}
      </div>
    </div>

    <div class="hero-features">
      {% for block in section.blocks %}
        <div class="hero-feature" {{ block.shopify_attributes }}>
          <div class="hero-feature-icon">{{ block.settings.icon }}</div>
          <div>
            <strong>{{ block.settings.title }}</strong>
            <span>{{ block.settings.text }}</span>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bannière Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Image de fond"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge",
      "default": "✨ Nouveau : Gamme Éco-Responsable 2025"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "Le Confort Climatique à Portée de Main"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Sous-titre",
      "default": "Découvrez nos solutions de climatisation haute performance, économiques et respectueuses de l'environnement. Installation professionnelle et garantie 5 ans."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Texte bouton 1",
      "default": "Découvrir nos produits"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Lien bouton 1",
      "default": "/collections/all"
    },
    {
      "type": "text",
      "id": "button_text_2",
      "label": "Texte bouton 2",
      "default": "Demander un devis"
    },
    {
      "type": "url",
      "id": "button_url_2",
      "label": "Lien bouton 2",
      "default": "/pages/contact"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Avantage",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icône (emoji)",
          "default": "❄️"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titre",
          "default": "Livraison Gratuite"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Texte",
          "default": "Dès 500€ d'achat"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bannière Hero",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "icon": "🚚",
            "title": "Livraison Gratuite",
            "text": "Dès 500€ d'achat"
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "🛡️",
            "title": "Garantie 5 ans",
            "text": "Pièces et main d'œuvre"
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "⚡",
            "title": "Classe A+++",
            "text": "Économie d'énergie"
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "🔧",
            "title": "Installation Pro",
            "text": "Techniciens certifiés"
          }
        }
      ]
    }
  ]
}
{% endschema %}
