{% comment %} Featured Collections Section {% endcomment %}
<section class="featured-collections section-padding">
  <div class="container">
    <div class="section-header">
      <span class="section-tag">{{ section.settings.tag }}</span>
      <h2 class="section-title">{{ section.settings.title }}</h2>
      <p class="section-subtitle">{{ section.settings.subtitle }}</p>
    </div>

    <div class="collections-grid">
      {% for block in section.blocks %}
        <a href="{{ block.settings.collection.url | default: '/collections/all' }}" class="collection-card" {{ block.shopify_attributes }}>
          <div class="collection-card-image">
            {% if block.settings.image %}
              <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.title }}" loading="lazy">
            {% else %}
              <div class="placeholder-bg" style="background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));">
                <span style="font-size:3rem;">{{ block.settings.icon }}</span>
              </div>
            {% endif %}
          </div>
          <div class="collection-card-content">
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.description }}</p>
            <span class="collection-link">Découvrir →</span>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collections vedettes",
  "settings": [
    {
      "type": "text",
      "id": "tag",
      "label": "Tag",
      "default": "Nos Catégories"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "Trouvez la Solution Idéale"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Sous-titre",
      "default": "Des systèmes adaptés à chaque besoin et chaque budget"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "icon",
          "label": "Icône (emoji)",
          "default": "❄️"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titre",
          "default": "Climatiseurs Split"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Solutions murales pour un confort optimal"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collections vedettes",
      "blocks": [
        {
          "type": "collection",
          "settings": {
            "icon": "❄️",
            "title": "Climatiseurs Split",
            "description": "Solutions murales haute performance"
          }
        },
        {
          "type": "collection",
          "settings": {
            "icon": "🌡️",
            "title": "Pompes à Chaleur",
            "description": "Chauffage et climatisation réversible"
          }
        },
        {
          "type": "collection",
          "settings": {
            "icon": "💨",
            "title": "Climatiseurs Portables",
            "description": "Mobilité et fraîcheur instantanée"
          }
        },
        {
          "type": "collection",
          "settings": {
            "icon": "🔧",
            "title": "Accessoires & Pièces",
            "description": "Tout pour l'entretien de vos équipements"
          }
        }
      ]
    }
  ]
}
{% endschema %}
