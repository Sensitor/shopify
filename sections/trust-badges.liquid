{% comment %} Trust Badges / Reassurance Section {% endcomment %}
<section class="trust-badges section-padding">
  <div class="container">
    <div class="trust-grid">
      {% for block in section.blocks %}
        <div class="trust-item" {{ block.shopify_attributes }}>
          <div class="trust-icon">{{ block.settings.icon }}</div>
          <h3 class="trust-title">{{ block.settings.title }}</h3>
          <p class="trust-text">{{ block.settings.text }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Badges de confiance",
  "settings": [],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icône (emoji)",
          "default": "✅"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titre",
          "default": "Garantie 5 ans"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Description",
          "default": "Tous nos produits sont garantis 5 ans pièces et main d'œuvre"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Badges de confiance",
      "blocks": [
        {
          "type": "badge",
          "settings": {
            "icon": "🚚",
            "title": "Livraison Rapide",
            "text": "Expédition sous 24/48h. Livraison gratuite dès 500€."
          }
        },
        {
          "type": "badge",
          "settings": {
            "icon": "🛡️",
            "title": "Garantie 5 Ans",
            "text": "Pièces et main d'œuvre. Service après-vente réactif."
          }
        },
        {
          "type": "badge",
          "settings": {
            "icon": "🔒",
            "title": "Paiement Sécurisé",
            "text": "CB, PayPal, virement. Transactions 100% sécurisées."
          }
        },
        {
          "type": "badge",
          "settings": {
            "icon": "📞",
            "title": "Conseil Expert",
            "text": "Notre équipe vous accompagne du lundi au samedi."
          }
        }
      ]
    }
  ]
}
{% endschema %}
