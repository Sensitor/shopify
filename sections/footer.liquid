{% comment %} Footer Section {% endcomment %}
<footer class="site-footer">
  <div class="footer-main">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-col footer-about">
          <h3 class="footer-title">{{ shop.name }}</h3>
          <p class="footer-desc">{{ section.settings.footer_description }}</p>
          <div class="footer-social">
            {% if section.settings.social_facebook != blank %}
              <a href="{{ section.settings.social_facebook }}" class="social-link" aria-label="Facebook" target="_blank" rel="noopener">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
              </a>
            {% endif %}
            {% if section.settings.social_instagram != blank %}
              <a href="{{ section.settings.social_instagram }}" class="social-link" aria-label="Instagram" target="_blank" rel="noopener">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="5"/><circle cx="17.5" cy="6.5" r="1.5" fill="currentColor" stroke="none"/></svg>
              </a>
            {% endif %}
          </div>
        </div>

        <div class="footer-col">
          <h4 class="footer-heading">Navigation</h4>
          <ul class="footer-links">
            {% for link in linklists.footer.links %}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {% endfor %}
            {% if linklists.footer.links.size == 0 %}
              <li><a href="/collections/all">Nos Produits</a></li>
              <li><a href="/pages/faq">FAQ</a></li>
              <li><a href="/pages/a-propos">À Propos</a></li>
              <li><a href="/pages/contact">Contact</a></li>
            {% endif %}
          </ul>
        </div>

        <div class="footer-col">
          <h4 class="footer-heading">Informations</h4>
          <ul class="footer-links">
            <li><a href="/pages/conditions-generales-de-vente">Conditions Générales de Vente</a></li>
            <li><a href="/policies/privacy-policy">Politique de Confidentialité</a></li>
            <li><a href="/policies/refund-policy">Politique de Retour</a></li>
            <li><a href="/policies/shipping-policy">Politique de Livraison</a></li>
            <li><a href="/pages/mentions-legales">Mentions Légales</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h4 class="footer-heading">Contact</h4>
          <ul class="footer-links footer-contact-info">
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.362 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.338 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              {{ section.settings.phone | default: '01 23 45 67 89' }}
            </li>
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              {{ section.settings.email | default: 'contact@climaconfort.fr' }}
            </li>
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              {{ section.settings.address | default: '12 Rue de la Climatisation, 75001 Paris' }}
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. Tous droits réservés.</p>
      <div class="footer-payments">
        <span>Paiement sécurisé</span>
        {% for type in shop.enabled_payment_types %}
          {{ type | payment_type_svg_tag }}
        {% endfor %}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Pied de page",
  "settings": [
    {
      "type": "textarea",
      "id": "footer_description",
      "label": "Description",
      "default": "Votre spécialiste en solutions de climatisation et confort thermique depuis 2015. Qualité, performance et économies d'énergie."
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Téléphone",
      "default": "01 23 45 67 89"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email",
      "default": "contact@climaconfort.fr"
    },
    {
      "type": "text",
      "id": "address",
      "label": "Adresse",
      "default": "12 Rue de la Climatisation, 75001 Paris"
    },
    {
      "type": "url",
      "id": "social_facebook",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "social_instagram",
      "label": "Instagram URL"
    }
  ]
}
{% endschema %}
