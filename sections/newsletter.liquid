{% comment %} Newsletter Section {% endcomment %}
<section class="section-padding newsletter-section">
  <div class="container">
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.subtext }}</p>

    {% form 'customer', class: 'newsletter-form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <input
        type="email"
        name="contact[email]"
        placeholder="{{ 'general.newsletter.label' | t }}"
        required
        aria-label="{{ 'general.newsletter.label' | t }}"
      >
      <button type="submit" class="btn">{{ 'general.newsletter.submit' | t }}</button>
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Restez Informe"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Sous-titre",
      "default": "Inscrivez-vous pour recevoir nos offres exclusives et conseils d'experts."
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
