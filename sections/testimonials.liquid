{% comment %} Testimonials Section {% endcomment %}
<section class="testimonials section-padding" style="background: var(--color-bg-alt);">
  <div class="container">
    <div class="section-header">
      <span class="section-tag">{{ section.settings.tag }}</span>
      <h2 class="section-title">{{ section.settings.title }}</h2>
    </div>

    <div class="testimonials-grid">
      {% for block in section.blocks %}
        <div class="testimonial-card" {{ block.shopify_attributes }}>
          <div class="testimonial-stars">
            {% for i in (1..5) %}
              {% if i <= block.settings.rating %}
                <svg width="18" height="18" viewBox="0 0 24 24" fill="#F59E0B"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              {% endif %}
            {% endfor %}
          </div>
          <p class="testimonial-text">"{{ block.settings.text }}"</p>
          <div class="testimonial-author">
            <div class="testimonial-avatar">{{ block.settings.author | slice: 0 }}</div>
            <div>
              <strong>{{ block.settings.author }}</strong>
              <span>{{ block.settings.location }}</span>
            </div>
          </div>
          {% if block.settings.product != blank %}
            <div class="testimonial-product">
              <small>A acheté : {{ block.settings.product }}</small>
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Témoignages",
  "settings": [
    {
      "type": "text",
      "id": "tag",
      "label": "Tag",
      "default": "Avis Clients"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "Ce Que Disent Nos Clients"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Témoignage",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "Note",
          "min": 1,
          "max": 5,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Témoignage",
          "default": "Excellente climatisation, silencieuse et performante. L'installation a été rapide et professionnelle."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Auteur",
          "default": "Marie D."
        },
        {
          "type": "text",
          "id": "location",
          "label": "Localisation",
          "default": "Paris, France"
        },
        {
          "type": "text",
          "id": "product",
          "label": "Produit acheté",
          "default": "ArctiFlow Pro 3500"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Témoignages",
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "rating": 5,
            "text": "Climatiseur incroyable ! Notre appartement est frais en été et chaud en hiver. La fonction réversible est un vrai plus. Installation impeccable par l'équipe ClimaConfort.",
            "author": "Marie D.",
            "location": "Paris 15e",
            "product": "ArctiFlow Pro 3500"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "rating": 5,
            "text": "Très bon rapport qualité/prix. Le climatiseur portable est parfait pour notre bureau. Livraison rapide et service client au top.",
            "author": "Thomas B.",
            "location": "Lyon",
            "product": "BreezeMax Mobile 2800"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "rating": 5,
            "text": "La pompe à chaleur a réduit notre facture de chauffage de 60%. Investissement rentabilisé en 2 ans. Je recommande vivement !",
            "author": "Sophie L.",
            "location": "Bordeaux",
            "product": "ThermoElite PAC 9000"
          }
        }
      ]
    }
  ]
}
{% endschema %}
