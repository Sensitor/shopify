{% comment %} Placeholder Product Card for when no collection is selected {% endcomment %}
{% assign placeholder_products = "ArctiFlow Pro 3500|BreezeMax Mobile 2800|ThermoElite PAC 9000|FrostGuard Split 2400|AirPure Zen 1800|ClimaWall Inverter 5000|IceBreeze Portable 3000|DuoTherm Réversible 4500" | split: "|" %}
{% assign placeholder_prices = "1299,00 €|699,00 €|2899,00 €|899,00 €|549,00 €|1599,00 €|749,00 €|1899,00 €" | split: "|" %}
{% assign placeholder_old_prices = "1499,00 €||3299,00 €|999,00 €||1799,00 €||2199,00 €" | split: "|" %}
{% assign placeholder_descs = "Climatiseur mural split inverter|Climatiseur portable 3-en-1|Pompe à chaleur air-eau|Climatiseur split compact|Purificateur-climatiseur|Climatiseur mural premium|Climatiseur mobile silencieux|Clim réversible bi-split" | split: "|" %}
{% assign placeholder_badges = "Best-seller||Promo||Nouveau|||Promo" | split: "|" %}

{% assign i = index | minus: 1 %}

<div class="product-card">
  <a href="#" class="product-card-link">
    <div class="product-card-image">
      <div class="placeholder-bg product-placeholder" style="background: linear-gradient(135deg, hsl({{ i | times: 40 | plus: 200 }}, 60%, 90%), hsl({{ i | times: 40 | plus: 220 }}, 70%, 80%));">
        <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="hsl({{ i | times: 40 | plus: 200 }}, 50%, 50%)" stroke-width="1">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z"/>
          <path d="M8 12h8M12 8v8"/>
        </svg>
      </div>

      {% if placeholder_badges[i] != blank %}
        <span class="product-badge {% if placeholder_badges[i] == 'Promo' %}badge-sale{% elsif placeholder_badges[i] == 'Nouveau' %}badge-new{% else %}badge-best{% endif %}">
          {{ placeholder_badges[i] }}
        </span>
      {% endif %}
    </div>

    <div class="product-card-info">
      <span class="product-vendor">ClimaConfort</span>
      <h3 class="product-title">{{ placeholder_products[i] }}</h3>
      <p class="product-desc">{{ placeholder_descs[i] }}</p>

      <div class="product-price">
        {% if placeholder_old_prices[i] != blank %}
          <span class="price-compare">{{ placeholder_old_prices[i] }}</span>
        {% endif %}
        <span class="price-current {% if placeholder_old_prices[i] != blank %}price-sale{% endif %}">
          {{ placeholder_prices[i] }}
        </span>
      </div>
    </div>
  </a>

  <button class="btn btn-primary btn-sm product-card-btn">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
    Ajouter au panier
  </button>
</div>
