{% comment %} Breadcrumb Navigation {% endcomment %}
<nav class="breadcrumb" aria-label="Fil d'Ariane">
  <div class="container">
    <a href="/">Accueil</a>
    {%- if template contains 'product' -%}
      {%- if product.collections.size > 0 -%}
        <span class="breadcrumb-separator">/</span>
        <a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a>
      {%- endif -%}
      <span class="breadcrumb-separator">/</span>
      <span aria-current="page">{{ product.title }}</span>
    {%- elsif template contains 'collection' -%}
      <span class="breadcrumb-separator">/</span>
      <span aria-current="page">{{ collection.title }}</span>
    {%- elsif template contains 'page' -%}
      <span class="breadcrumb-separator">/</span>
      <span aria-current="page">{{ page.title }}</span>
    {%- elsif template contains 'blog' -%}
      <span class="breadcrumb-separator">/</span>
      <span aria-current="page">{{ blog.title }}</span>
    {%- elsif template contains 'article' -%}
      <span class="breadcrumb-separator">/</span>
      <a href="{{ blog.url }}">{{ blog.title }}</a>
      <span class="breadcrumb-separator">/</span>
      <span aria-current="page">{{ article.title }}</span>
    {%- elsif template contains 'search' -%}
      <span class="breadcrumb-separator">/</span>
      <span aria-current="page">Recherche</span>
    {%- elsif template contains 'cart' -%}
      <span class="breadcrumb-separator">/</span>
      <span aria-current="page">Panier</span>
    {%- endif -%}
  </div>
</nav>
