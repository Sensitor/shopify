{% comment %} Customer Account Template {% endcomment %}
<div class="account-page section-padding">
  <div class="container">
    <div class="account-header">
      <h1 class="page-title">Mon Compte</h1>
      <a href="/account/logout" class="btn btn-outline btn-sm">Se déconnecter</a>
    </div>

    <div class="account-grid">
      <div class="account-info">
        <h2>Informations</h2>
        <p><strong>{{ customer.name }}</strong></p>
        <p>{{ customer.email }}</p>
        {% if customer.default_address %}
          <p>{{ customer.default_address | format_address }}</p>
        {% endif %}
        <a href="/account/addresses" class="btn btn-outline btn-sm" style="margin-top:1rem;">Gérer mes adresses</a>
      </div>

      <div class="account-orders">
        <h2>Historique des commandes</h2>
        {% if customer.orders.size > 0 %}
          <table class="orders-table">
            <thead>
              <tr>
                <th>Commande</th>
                <th>Date</th>
                <th>Statut</th>
                <th>Total</th>
              </tr>
            </thead>
            <tbody>
              {% for order in customer.orders %}
                <tr>
                  <td><a href="{{ order.customer_url }}">{{ order.name }}</a></td>
                  <td>{{ order.created_at | date: '%d/%m/%Y' }}</td>
                  <td>{{ order.fulfillment_status_label }}</td>
                  <td>{{ order.total_price | money }}</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        {% else %}
          <p>Vous n'avez pas encore passé de commande.</p>
          <a href="/collections/all" class="btn btn-primary">Découvrir nos produits</a>
        {% endif %}
      </div>
    </div>
  </div>
</div>
