{% comment %} Account Activation Page {% endcomment %}
<div class="customer-page">
  <div class="container">
    <h1>Activer Mon Compte</h1>
    <p style="text-align: center; color: var(--color-text-light); margin-bottom: 32px;">
      Creez votre mot de passe pour activer votre compte.
    </p>

    {% form 'activate_customer_password', class: 'customer-form' %}
      {% if form.errors %}
        <div class="form-errors" style="color: var(--color-accent); margin-bottom: 16px;">
          {{ form.errors | default_errors }}
        </div>
      {% endif %}

      <div class="form-group">
        <label for="password">Mot de passe</label>
        <input type="password" id="password" name="customer[password]" required>
      </div>
      <div class="form-group">
        <label for="password_confirmation">Confirmer le mot de passe</label>
        <input type="password" id="password_confirmation" name="customer[password_confirmation]" required>
      </div>
      <div class="form-actions">
        <button type="submit" class="btn btn-primary btn-lg" style="width: 100%;">Activer mon compte</button>
      </div>
    {% endform %}

    <p class="form-link">
      <a href="{{ routes.account_login_url }}">Vous avez deja un compte ? Connexion</a>
    </p>
  </div>
</div>
