{% comment %} Customer Order Detail Page {% endcomment %}
<div class="customer-page">
  <div class="container">
    <a href="/account" style="color: var(--color-primary); font-size: 0.9rem; display: inline-flex; align-items: center; gap: 4px; margin-bottom: 24px;">
      &larr; Retour a mon compte
    </a>

    <h1>Commande {{ order.name }}</h1>
    <p style="color: var(--color-text-light); margin-bottom: 32px;">
      Passee le {{ order.created_at | date: "%d/%m/%Y a %H:%M" }}
    </p>

    {% if order.cancelled %}
      <div style="background: #FEF2F2; border: 1px solid #FECACA; border-radius: var(--radius); padding: 16px; margin-bottom: 24px;">
        <p style="color: #DC2626; font-weight: 600; margin: 0;">Commande annulee le {{ order.cancelled_at | date: "%d/%m/%Y" }} - {{ order.cancel_reason_label }}</p>
      </div>
    {% endif %}

    <table class="orders-table" style="margin-bottom: 32px;">
      <thead>
        <tr>
          <th>Produit</th>
          <th>Quantite</th>
          <th>Prix</th>
          <th>Total</th>
        </tr>
      </thead>
      <tbody>
        {% for line_item in order.line_items %}
          <tr>
            <td>
              <strong>{{ line_item.title }}</strong>
              {% if line_item.variant.title != 'Default Title' %}
                <br><span style="color: var(--color-text-light); font-size: 0.85rem;">{{ line_item.variant.title }}</span>
              {% endif %}
              {% if line_item.fulfillment %}
                <br><span style="color: var(--color-success); font-size: 0.85rem;">Expedie le {{ line_item.fulfillment.created_at | date: "%d/%m/%Y" }}</span>
              {% endif %}
            </td>
            <td>{{ line_item.quantity }}</td>
            <td>{{ line_item.price | money }}</td>
            <td>{{ line_item.line_price | money }}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 32px;">
      <div>
        <h3 style="margin-bottom: 12px;">Adresse de livraison</h3>
        {% if order.shipping_address %}
          <p>{{ order.shipping_address.first_name }} {{ order.shipping_address.last_name }}</p>
          <p>{{ order.shipping_address.address1 }}</p>
          {% if order.shipping_address.address2 != blank %}<p>{{ order.shipping_address.address2 }}</p>{% endif %}
          <p>{{ order.shipping_address.zip }} {{ order.shipping_address.city }}</p>
          <p>{{ order.shipping_address.country }}</p>
        {% endif %}
      </div>

      <div>
        <h3 style="margin-bottom: 12px;">Recapitulatif</h3>
        <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
          <span>Sous-total</span>
          <span>{{ order.subtotal_price | money }}</span>
        </div>
        {% for shipping_method in order.shipping_methods %}
          <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
            <span>Livraison ({{ shipping_method.title }})</span>
            <span>{{ shipping_method.price | money }}</span>
          </div>
        {% endfor %}
        {% for tax_line in order.tax_lines %}
          <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
            <span>{{ tax_line.title }} {{ tax_line.rate | times: 100 }}%</span>
            <span>{{ tax_line.price | money }}</span>
          </div>
        {% endfor %}
        <div style="display: flex; justify-content: space-between; font-weight: 700; font-size: 1.2rem; padding-top: 12px; border-top: 2px solid var(--color-border);">
          <span>Total</span>
          <span>{{ order.total_price | money }}</span>
        </div>
      </div>
    </div>
  </div>
</div>
