{% comment %} Customer Addresses Page {% endcomment %}
<div class="customer-page">
  <div class="container">
    <h1>Mes Adresses</h1>

    <div style="text-align: right; margin-bottom: 24px;">
      <button class="btn btn-primary" onclick="document.getElementById('new-address-form').style.display = document.getElementById('new-address-form').style.display === 'none' ? 'block' : 'none'">
        Ajouter une adresse
      </button>
    </div>

    <div id="new-address-form" style="display: none; margin-bottom: 40px; padding: 32px; background: var(--color-bg-alt); border-radius: var(--radius);">
      <h2 style="margin-bottom: 24px;">Nouvelle Adresse</h2>
      {% form 'customer_address', customer.new_address, class: 'customer-form' %}
        <div class="form-group">
          <label for="address_first_name">Prenom</label>
          <input type="text" id="address_first_name" name="address[first_name]" value="{{ form.first_name }}">
        </div>
        <div class="form-group">
          <label for="address_last_name">Nom</label>
          <input type="text" id="address_last_name" name="address[last_name]" value="{{ form.last_name }}">
        </div>
        <div class="form-group">
          <label for="address_company">Societe</label>
          <input type="text" id="address_company" name="address[company]" value="{{ form.company }}">
        </div>
        <div class="form-group">
          <label for="address_address1">Adresse</label>
          <input type="text" id="address_address1" name="address[address1]" value="{{ form.address1 }}">
        </div>
        <div class="form-group">
          <label for="address_address2">Complement d'adresse</label>
          <input type="text" id="address_address2" name="address[address2]" value="{{ form.address2 }}">
        </div>
        <div class="form-group">
          <label for="address_city">Ville</label>
          <input type="text" id="address_city" name="address[city]" value="{{ form.city }}">
        </div>
        <div class="form-group">
          <label for="address_zip">Code postal</label>
          <input type="text" id="address_zip" name="address[zip]" value="{{ form.zip }}">
        </div>
        <div class="form-group">
          <label for="address_country">Pays</label>
          <select id="address_country" name="address[country]" data-default="{{ form.country }}">
            {{ all_country_option_tags }}
          </select>
        </div>
        <div class="form-group">
          <label for="address_phone">Telephone</label>
          <input type="tel" id="address_phone" name="address[phone]" value="{{ form.phone }}">
        </div>
        <div class="form-group">
          <label>
            <input type="checkbox" name="address[default]" value="1"> Definir comme adresse par defaut
          </label>
        </div>
        <div class="form-actions">
          <button type="submit" class="btn btn-primary">Enregistrer</button>
        </div>
      {% endform %}
    </div>

    {% if customer.addresses.size > 0 %}
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 24px;">
        {% for address in customer.addresses %}
          <div style="padding: 24px; border: 1px solid var(--color-border); border-radius: var(--radius);">
            {% if address == customer.default_address %}
              <span class="product-badge badge-new" style="position: static; margin-bottom: 12px; display: inline-block;">Par defaut</span>
            {% endif %}
            <p>{{ address.first_name }} {{ address.last_name }}</p>
            {% if address.company != blank %}<p>{{ address.company }}</p>{% endif %}
            <p>{{ address.address1 }}</p>
            {% if address.address2 != blank %}<p>{{ address.address2 }}</p>{% endif %}
            <p>{{ address.zip }} {{ address.city }}</p>
            <p>{{ address.country }}</p>
            {% if address.phone != blank %}<p>{{ address.phone }}</p>{% endif %}

            <div style="margin-top: 16px; display: flex; gap: 8px;">
              <a href="/account/addresses/{{ address.id }}" class="btn btn-outline btn-sm">Modifier</a>
              {% form 'customer_address', address %}
                <input type="hidden" name="_method" value="delete">
                <button type="submit" class="btn btn-sm" style="color: var(--color-accent);">Supprimer</button>
              {% endform %}
            </div>
          </div>
        {% endfor %}
      </div>
    {% else %}
      <p style="text-align: center; color: var(--color-text-light);">Aucune adresse enregistree.</p>
    {% endif %}
  </div>
</div>
