{% comment %} 404 Page {% endcomment %}
<div class="page-404 section-padding">
  <div class="container" style="text-align: center; padding: 4rem 1rem;">
    <div style="font-size: 6rem; margin-bottom: 1rem;">❄️</div>
    <h1 style="font-size: 4rem; color: var(--color-primary); margin-bottom: 0.5rem;">404</h1>
    <h2>Page non trouvée</h2>
    <p style="color: var(--color-text-light); margin-bottom: 2rem;">
      Oups ! La page que vous cherchez semble avoir pris froid et s'est envolée.<br>
      Pas de panique, nous allons vous remettre au frais.
    </p>
    <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
      <a href="/" class="btn btn-primary">Retour à l'accueil</a>
      <a href="/collections/all" class="btn btn-outline">Voir nos produits</a>
    </div>
  </div>
</div>
