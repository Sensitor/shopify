{% comment %} Product Template {% endcomment %}
<div class="product-page section-padding">
  <div class="container">
    <nav class="breadcrumb">
      <a href="/">Accueil</a>
      <span>/</span>
      {% if collection %}
        <a href="{{ collection.url }}">{{ collection.title }}</a>
        <span>/</span>
      {% endif %}
      <span>{{ product.title }}</span>
    </nav>

    <div class="product-main">
      <div class="product-gallery">
        <div class="product-image-main">
          {% if product.featured_image %}
            <img
              id="product-main-image"
              src="{{ product.featured_image | image_url: width: 800 }}"
              alt="{{ product.featured_image.alt | default: product.title }}"
            >
          {% else %}
            <div class="placeholder-bg" style="height:500px; background: linear-gradient(135deg, var(--color-primary), var(--color-secondary)); display:flex; align-items:center; justify-content:center; border-radius: var(--radius);">
              <svg width="96" height="96" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
            </div>
          {% endif %}
        </div>

        {% if product.images.size > 1 %}
          <div class="product-thumbnails">
            {% for image in product.images %}
              <button class="product-thumbnail {% if forloop.first %}active{% endif %}" onclick="document.getElementById('product-main-image').src='{{ image | image_url: width: 800 }}'; document.querySelectorAll('.product-thumbnail').forEach(t=>t.classList.remove('active')); this.classList.add('active');">
                <img src="{{ image | image_url: width: 100 }}" alt="{{ image.alt | default: product.title }}">
              </button>
            {% endfor %}
          </div>
        {% endif %}
      </div>

      <div class="product-info">
        {% if product.vendor %}
          <span class="product-vendor-label">{{ product.vendor }}</span>
        {% endif %}

        <h1 class="product-page-title">{{ product.title }}</h1>

        <div class="product-page-price">
          {% if product.compare_at_price > product.price %}
            <span class="price-compare-large">{{ product.compare_at_price | money }}</span>
            <span class="price-save">Économisez {{ product.compare_at_price | minus: product.price | money }}</span>
          {% endif %}
          <span class="price-current-large {% if product.compare_at_price > product.price %}price-sale{% endif %}">
            {{ product.price | money }}
          </span>
          <span class="price-tax-note">TTC - Livraison calculée à la caisse</span>
        </div>

        <div class="product-short-desc">
          {{ product.description | strip_html | truncatewords: 40 }}
        </div>

        {% form 'product', product %}
          {% if product.variants.size > 1 %}
            <div class="product-variants">
              {% for option in product.options_with_values %}
                <div class="variant-selector">
                  <label for="option-{{ forloop.index }}">{{ option.name }}</label>
                  <select id="option-{{ forloop.index }}" name="id" class="variant-select">
                    {% for variant in product.variants %}
                      <option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>
                        {{ variant.title }} {% unless variant.available %}- Rupture{% endunless %}
                        {% if variant.price != product.price %} - {{ variant.price | money }}{% endif %}
                      </option>
                    {% endfor %}
                  </select>
                </div>
              {% endfor %}
            </div>
          {% else %}
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          {% endif %}

          <div class="product-quantity">
            <label for="quantity">Quantité</label>
            <div class="quantity-selector">
              <button type="button" class="qty-btn" onclick="var q=document.getElementById('quantity'); q.value=Math.max(1,parseInt(q.value)-1);">−</button>
              <input type="number" id="quantity" name="quantity" value="1" min="1" max="99">
              <button type="button" class="qty-btn" onclick="var q=document.getElementById('quantity'); q.value=Math.min(99,parseInt(q.value)+1);">+</button>
            </div>
          </div>

          <div class="product-actions">
            {% if product.available %}
              <button type="submit" class="btn btn-primary btn-lg btn-full">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                Ajouter au panier — {{ product.price | money }}
              </button>
            {% else %}
              <button type="button" class="btn btn-disabled btn-lg btn-full" disabled>
                Produit en rupture de stock
              </button>
            {% endif %}
          </div>
        {% endform %}

        <div class="product-guarantees">
          <div class="guarantee-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-success)" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            Livraison gratuite dès 500€
          </div>
          <div class="guarantee-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-success)" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            Garantie 5 ans
          </div>
          <div class="guarantee-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-success)" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            Retour sous 30 jours
          </div>
          <div class="guarantee-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-success)" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            Paiement sécurisé
          </div>
        </div>
      </div>
    </div>

    {% if product.description != blank %}
      <div class="product-description-full">
        <div class="product-tabs">
          <button class="tab-btn active" onclick="showTab(this, 'tab-description')">Description</button>
          <button class="tab-btn" onclick="showTab(this, 'tab-specs')">Caractéristiques</button>
          <button class="tab-btn" onclick="showTab(this, 'tab-shipping')">Livraison & Retours</button>
        </div>

        <div id="tab-description" class="tab-content active">
          <div class="rte">{{ product.description }}</div>
        </div>

        <div id="tab-specs" class="tab-content">
          <div class="specs-grid">
            {% for tag in product.tags %}
              {% assign tag_parts = tag | split: ':' %}
              {% if tag_parts.size == 2 %}
                <div class="spec-row">
                  <span class="spec-label">{{ tag_parts[0] | strip }}</span>
                  <span class="spec-value">{{ tag_parts[1] | strip }}</span>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>

        <div id="tab-shipping" class="tab-content">
          <h3>Livraison</h3>
          <ul>
            <li>Expédition sous 24 à 48h ouvrées</li>
            <li>Livraison gratuite à partir de 500€ d'achat</li>
            <li>Livraison standard : 4-6 jours ouvrés (à partir de 9,90€)</li>
            <li>Livraison express : 1-2 jours ouvrés (à partir de 19,90€)</li>
            <li>Livraison par transporteur spécialisé pour les équipements lourds</li>
          </ul>
          <h3>Retours</h3>
          <ul>
            <li>Retour gratuit sous 30 jours</li>
            <li>Produit dans son emballage d'origine</li>
            <li>Remboursement sous 14 jours après réception</li>
          </ul>
        </div>
      </div>
    {% endif %}
  </div>
</div>

<script>
function showTab(btn, tabId) {
  document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
  document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
  btn.classList.add('active');
  document.getElementById(tabId).classList.add('active');
}
</script>
