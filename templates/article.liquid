{% comment %} Blog Article Template {% endcomment %}
{% render 'breadcrumb' %}

<article class="section-padding">
  <div class="container">
    <div class="rich-text-content">
      <h1>{{ article.title }}</h1>
      <p style="color: var(--color-text-light); margin-bottom: 32px;">
        Par {{ article.author }} | {{ article.published_at | date: "%d/%m/%Y" }}
        {% if article.tags.size > 0 %}
          |
          {% for tag in article.tags %}
            <a href="{{ blog.url }}/tagged/{{ tag | handle }}" style="color: var(--color-primary);">{{ tag }}</a>{% unless forloop.last %}, {% endunless %}
          {% endfor %}
        {% endif %}
      </p>

      {% if article.image %}
        <div style="margin-bottom: 32px; border-radius: var(--radius); overflow: hidden;">
          <img src="{{ article.image | image_url: width: 1200 }}" alt="{{ article.image.alt | default: article.title }}" width="1200">
        </div>
      {% endif %}

      <div class="legal-content">
        {{ article.content }}
      </div>

      {% if blog.comments_enabled? %}
        <div style="margin-top: 60px; padding-top: 40px; border-top: 2px solid var(--color-border);">
          <h2>Commentaires ({{ article.comments_count }})</h2>

          {% paginate article.comments by 10 %}
            {% for comment in article.comments %}
              <div style="padding: 20px 0; border-bottom: 1px solid var(--color-border);">
                <p style="font-weight: 600;">{{ comment.author }}</p>
                <p style="font-size: 0.85rem; color: var(--color-text-light); margin-bottom: 8px;">{{ comment.created_at | date: "%d/%m/%Y a %H:%M" }}</p>
                <p>{{ comment.content }}</p>
              </div>
            {% endfor %}

            {% render 'pagination', paginate: paginate %}
          {% endpaginate %}

          {% form 'new_comment', article, class: 'contact-form', style: 'margin-top: 32px;' %}
            <h3>Laisser un commentaire</h3>
            {% if form.errors %}
              <div style="color: var(--color-accent);">{{ form.errors | default_errors }}</div>
            {% endif %}
            {% if form.posted_successfully? %}
              <p style="color: var(--color-success); font-weight: 600;">Votre commentaire a ete soumis avec succes.</p>
            {% endif %}
            <div class="form-group">
              <label for="comment-author">Nom</label>
              <input type="text" id="comment-author" name="comment[author]" value="{{ form.author }}" required>
            </div>
            <div class="form-group">
              <label for="comment-email">Email</label>
              <input type="email" id="comment-email" name="comment[email]" value="{{ form.email }}" required>
            </div>
            <div class="form-group">
              <label for="comment-body">Commentaire</label>
              <textarea id="comment-body" name="comment[body]" rows="4" required>{{ form.body }}</textarea>
            </div>
            <button type="submit" class="btn btn-primary">Publier</button>
          {% endform %}
        </div>
      {% endif %}
    </div>
  </div>
</article>
