{% comment %} Search Results Template {% endcomment %}
<div class="search-page section-padding">
  <div class="container">
    <h1 class="page-title">Recherche</h1>

    <div class="search-form-wrapper">
      <form action="/search" method="get" class="search-form-large">
        <input type="text" name="q" value="{{ search.terms | escape }}" placeholder="Rechercher un produit..." class="search-input-large" autofocus>
        <button type="submit" class="btn btn-primary">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
          Rechercher
        </button>
      </form>
    </div>

    {% if search.performed %}
      <p class="search-results-count">
        {{ search.results_count }} résultat{% if search.results_count > 1 %}s{% endif %}
        pour "{{ search.terms }}"
      </p>

      {% if search.results_count > 0 %}
        <div class="products-grid">
          {% for item in search.results %}
            {% if item.object_type == 'product' %}
              {% render 'product-card', product: item %}
            {% else %}
              <div class="search-result-item">
                <h3><a href="{{ item.url }}">{{ item.title }}</a></h3>
                <p>{{ item.content | strip_html | truncatewords: 30 }}</p>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      {% else %}
        <div class="search-empty">
          <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="var(--color-text-light)" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
          <h2>Aucun résultat</h2>
          <p>Essayez avec d'autres mots-clés ou explorez nos collections.</p>
          <a href="/collections/all" class="btn btn-primary">Voir tous les produits</a>
        </div>
      {% endif %}
    {% endif %}
  </div>
</div>
