{% comment %} Blog Listing Template {% endcomment %}
{% render 'breadcrumb' %}

<div class="section-padding">
  <div class="container">
    <div class="section-header">
      <h1>{{ blog.title }}</h1>
    </div>

    {% paginate blog.articles by 9 %}
      <div class="products-grid" style="grid-template-columns: repeat(3, 1fr);">
        {% for article in blog.articles %}
          <article class="product-card">
            <a href="{{ article.url }}" class="product-card-link">
              {% if article.image %}
                <div class="product-card-image" style="aspect-ratio: 16/9;">
                  <img src="{{ article.image | image_url: width: 600 }}" alt="{{ article.image.alt | default: article.title }}" loading="lazy" width="600" height="338">
                </div>
              {% endif %}
              <div class="product-card-info">
                <span class="product-vendor">{{ article.published_at | date: "%d/%m/%Y" }}</span>
                <h3 class="product-title">{{ article.title }}</h3>
                <p style="font-size: 0.9rem; color: var(--color-text-light);">{{ article.excerpt_or_content | strip_html | truncate: 120 }}</p>
              </div>
            </a>
          </article>
        {% endfor %}
      </div>

      {% render 'pagination', paginate: paginate %}
    {% endpaginate %}
  </div>
</div>
