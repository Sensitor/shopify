{% comment %} Cart Template {% endcomment %}
<div class="cart-page section-padding">
  <div class="container">
    <h1 class="page-title">Votre Panier</h1>

    {% if cart.item_count > 0 %}
      <div class="cart-layout">
        <div class="cart-items">
          <form action="/cart" method="post" id="cart-form">
            {% for item in cart.items %}
              <div class="cart-item">
                <div class="cart-item-image">
                  {% if item.image %}
                    <img src="{{ item.image | image_url: width: 150 }}" alt="{{ item.title }}">
                  {% else %}
                    <div class="placeholder-bg" style="width:100px;height:100px;border-radius:8px;"></div>
                  {% endif %}
                </div>

                <div class="cart-item-details">
                  <h3><a href="{{ item.url }}">{{ item.product.title }}</a></h3>
                  {% if item.variant.title != 'Default Title' %}
                    <p class="cart-item-variant">{{ item.variant.title }}</p>
                  {% endif %}
                  <p class="cart-item-price">{{ item.price | money }}</p>
                </div>

                <div class="cart-item-quantity">
                  <div class="quantity-selector">
                    <button type="button" class="qty-btn" onclick="updateQty('{{ item.key }}', {{ item.quantity | minus: 1 }})">−</button>
                    <input type="number" name="updates[{{ item.key }}]" value="{{ item.quantity }}" min="0" max="99" class="qty-input">
                    <button type="button" class="qty-btn" onclick="updateQty('{{ item.key }}', {{ item.quantity | plus: 1 }})">+</button>
                  </div>
                </div>

                <div class="cart-item-total">
                  <span>{{ item.line_price | money }}</span>
                  <a href="/cart/change?id={{ item.key }}&quantity=0" class="cart-item-remove" aria-label="Supprimer">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                  </a>
                </div>
              </div>
            {% endfor %}
          </form>
        </div>

        <div class="cart-summary">
          <div class="cart-summary-card">
            <h2>Récapitulatif</h2>

            <div class="cart-summary-row">
              <span>Sous-total</span>
              <span>{{ cart.total_price | money }}</span>
            </div>

            <div class="cart-summary-row">
              <span>Livraison</span>
              <span>Calculée à l'étape suivante</span>
            </div>

            {% if cart.total_price >= 50000 %}
              <div class="cart-summary-row cart-free-shipping">
                <span>🚚 Livraison gratuite !</span>
              </div>
            {% else %}
              <div class="cart-summary-progress">
                <p>Plus que {{ 50000 | minus: cart.total_price | money }} pour la livraison gratuite</p>
                <div class="progress-bar">
                  <div class="progress-fill" style="width: {{ cart.total_price | times: 100 | divided_by: 50000 | at_most: 100 }}%"></div>
                </div>
              </div>
            {% endif %}

            <div class="cart-summary-total">
              <span>Total</span>
              <span>{{ cart.total_price | money }}</span>
            </div>

            <a href="/checkout" class="btn btn-primary btn-lg btn-full">
              Procéder au paiement
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>

            <a href="/collections/all" class="cart-continue-shopping">
              ← Continuer mes achats
            </a>

            <div class="cart-payment-icons">
              <span>Paiement sécurisé</span>
              <div>
                {% for type in shop.enabled_payment_types %}
                  {{ type | payment_type_svg_tag }}
                {% endfor %}
              </div>
            </div>
          </div>
        </div>
      </div>

    {% else %}
      <div class="cart-empty">
        <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="var(--color-text-light)" stroke-width="1.5"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
        <h2>Votre panier est vide</h2>
        <p>Découvrez nos solutions de climatisation et trouvez le produit idéal pour votre confort.</p>
        <a href="/collections/all" class="btn btn-primary btn-lg">Découvrir nos produits</a>
      </div>
    {% endif %}
  </div>
</div>

<script>
function updateQty(key, qty) {
  if (qty < 0) qty = 0;
  window.location.href = '/cart/change?id=' + key + '&quantity=' + qty;
}
</script>
