# Supabase (clés côté client, anon)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Supabase service role (serveur uniquement, jamais exposé)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# CoinGecko (serveur uniquement — proxy via /api/prices)
COINGECKO_API_KEY=YOUR_COINGECKO_KEY
# Pour la clé demo, l'endpoint est api.coingecko.com (gratuit, rate-limit faible).
# Pour Pro, c'est pro-api.coingecko.com.
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# Stripe (Phase 2)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
